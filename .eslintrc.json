{
  "env": {
    "browser": true,
    "es2021": true,
    "jquery": true,
    "webextensions": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": "warn",
    "no-empty": "off",
    "no-global-assign": "off",
    "no-cond-assign": "off",
    "no-redeclare": "off",
    "no-inner-declarations": "off"
  }
}
