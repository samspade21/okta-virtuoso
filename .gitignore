# OS cruft
.DS_Store
Thumbs.db

# Editors/IDEs
.vscode/
.idea/
*.swp

# Node (pre-commit's eslint hook manages its own isolated env, but ignore
# this in case anyone adds tooling that needs it locally)
node_modules/

# Logs
*.log
npm-debug.log*

# Env / secrets
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# Browser session captures — these can contain cookies, auth tokens, and
# other sensitive request/response data. Never commit these.
*.har

# Packed extension artifacts
*.crx
*.zip
